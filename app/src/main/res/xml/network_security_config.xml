<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Enforces HTTPS in Kotlin for public hosts while allowing local LAN Ollama servers -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
